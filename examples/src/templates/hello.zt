const User = @import("../models.zig").User;

pub templ hello(name: []const u8) {
    <div class="greeting">
        <h1>Hello, {name}!</h1>
    </div>
}

pub templ list(items: []const []const u8) {
    <ul>
        for (items) |item| {
            <li>{item}</li>
        }
    </ul>
}

pub templ userCard(user: User) {
    <div class="user-card">
        <h2>{user.name}</h2>
        <p>{user.email}</p>
        {if (user.is_admin) <span class="badge">Admin</span>}
    </div>
}

pub templ userList(users: []const User) {
    <div class="user-list">
        for (users) |user| {
            @userCard(user)
        }
    </div>
}

pub templ layout(title: []const u8) {
    <html>
        <head><title>{title}</title></head>
        <body>@children</body>
    </html>
}

pub templ section(title: []const u8) {
    <section>
        <h2>{title}</h2>
        @children
    </section>
}

pub templ page(title: []const u8, user: User) {
    @layout(title) {
        @section("Profile") {
            <p>{user.name}</p>
        }
        @section("Contact") {
            <p>{user.email}</p>
        }
    }
}

pub templ sidebar(title: []const u8, content: zt.Component) {
    <aside>
        <h3>{title}</h3>
        @content
    </aside>
}
